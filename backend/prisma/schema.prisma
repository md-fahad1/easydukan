generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  MANAGER
  EMPLOYEE
}

enum PaymentType {
  CUSTOMER_RECEIVE
  SUPPLIER_PAY
  SUPPLIER_LEND
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  ownerName String
  phone     String
  shopType  String   @default("মুদি দোকান")
  plan      String   @default("FREE")
  createdAt DateTime @default(now())
  users     User[]
}

model User {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  phone     String   @unique
  password  String
  role      Role     @default(OWNER)
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

model Customer {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  phone     String?
  balance   Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sales     Sale[]

  @@index([tenantId])
}

model Supplier {
  id        String     @id @default(uuid())
  tenantId  String
  name      String
  phone     String?
  balance   Float      @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  purchases Purchase[]

  @@index([tenantId])
}

model Product {
  id             String         @id @default(uuid())
  tenantId       String
  name           String
  unit           String         @default("pcs")
  purchasePrice  Float          @default(0)
  sellingPrice   Float          @default(0)
  stock          Float          @default(0)
  minStock       Float          @default(0)
  barcode        String?
  genericName    String?
  company        String?
  form           String         @default("GENERAL")
  piecesPerStrip Int            @default(1)
  stripsPerBox   Int            @default(1)
  createdAt      DateTime       @default(now())
  batches        ProductBatch[]

  @@index([tenantId])
  @@index([tenantId, barcode])
}

model Sale {
  id          String     @id @default(uuid())
  tenantId    String
  customerId  String?
  total       Float
  cost        Float      @default(0)
  cashAmount  Float      @default(0)
  bkashAmount Float      @default(0)
  dueAmount   Float      @default(0)
  note        String?
  createdBy   String?
  createdAt   DateTime   @default(now())
  customer    Customer?  @relation(fields: [customerId], references: [id])
  items       SaleItem[]
  returns     SaleReturn[]

  @@index([tenantId, createdAt])
}

model SaleItem {
  id        String  @id @default(uuid())
  saleId    String
  productId String?
  name      String
  qty       Float
  price     Float
  cost      Float   @default(0)
  unit      String?
  pieces    Float   @default(0)
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
}

model Expense {
  id        String   @id @default(uuid())
  tenantId  String
  category  String
  amount    Float
  note      String?
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
}

model Purchase {
  id         String         @id @default(uuid())
  tenantId   String
  supplierId String?
  total      Float
  paid       Float          @default(0)
  due        Float          @default(0)
  createdAt  DateTime       @default(now())
  supplier   Supplier?      @relation(fields: [supplierId], references: [id])
  items      PurchaseItem[]

  @@index([tenantId, createdAt])
}

model PurchaseItem {
  id         String   @id @default(uuid())
  purchaseId String
  productId  String?
  name       String
  qty        Float
  cost       Float
  unit       String?
  pieces     Float    @default(0)
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
}
model Payment {
  id         String      @id @default(uuid())
  tenantId   String
  type       PaymentType
  customerId String?
  supplierId String?
  amount     Float
  method     String      @default("CASH")
  createdAt  DateTime    @default(now())

  @@index([tenantId, createdAt])
}

model DailyClosing {
  id         String   @id @default(uuid())
  tenantId   String
  date       String
  totalSale  Float
  cash       Float
  bkash      Float
  due        Float
  expense    Float
  profit     Float
  cashInHand Float
  createdAt  DateTime @default(now())

  @@unique([tenantId, date])
}
model ProductBatch {
  id        String    @id @default(uuid())
  tenantId  String
  productId String
  batchNo   String?
  purchaseId String?
  expiry    DateTime?
  qty       Float
  cost      Float     @default(0)
  createdAt DateTime  @default(now())
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([tenantId, expiry])
  @@index([purchaseId])
  @@index([productId])
}

model SaleReturn {
  id           String           @id @default(uuid())
  tenantId     String
  saleId       String
  total        Float
  cost         Float            @default(0)
  dueAdjusted  Float            @default(0)
  refund       Float            @default(0)
  refundMethod String           @default("CASH")
  note         String?
  createdBy    String?
  createdAt    DateTime         @default(now())
  sale         Sale             @relation(fields: [saleId], references: [id], onDelete: Cascade)
  items        SaleReturnItem[]

  @@index([tenantId, createdAt])
  @@index([saleId])
}

model SaleReturnItem {
  id         String     @id @default(uuid())
  returnId   String
  saleItemId String
  productId  String?
  name       String
  unit       String?
  qty        Float
  pieces     Float      @default(0)
  price      Float
  cost       Float      @default(0)
  saleReturn SaleReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)

  @@index([saleItemId])
  @@index([returnId])
}
model MedicineCatalog {
  id          Int     @id @default(autoincrement())
  brand       String
  genericName String
  strength    String?
  dosage      String
  form        String
  company     String

  @@index([brand])
  @@index([genericName])
}